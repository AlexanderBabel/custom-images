+++ b/postgres-appliance/build_scripts/base.sh
@@ -166,6 +166,14 @@ for version in $DEB_PG_SUPPORTED_VERSIONS; do
     fi
 
     # Install 3rd party stuff
+    case "$(uname -m)" in
