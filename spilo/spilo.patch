+    apt-get install -y "./$VCHORD_DEB"
+    rm -v "./$VCHORD_DEB"
 
     if [ "${TIMESCALEDB_APACHE_ONLY}" != "true" ] && [ "${TIMESCALEDB_TOOLKIT}" = "true" ]; then
         apt-get update
