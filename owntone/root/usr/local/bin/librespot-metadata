#!/bin/sh
# librespot --onevent hook: translate a track change into the Shairport Sync
# metadata items OwnTone's pipe input understands (src/inputs/pipe.c).
# Only title/artist/album/cover are handled - those are the codes OwnTone maps
# to something visible in Home Assistant.
set -u

[ "${PLAYER_EVENT:-}" = "track_changed" ] || exit 0

PIPE="${METADATA_PIPE:-/music/Spotify.metadata}"
[ -p "$PIPE" ] || exit 0

# <dmap code as hex> <byte length> <base64 payload>
item() {
	printf '<item><type>%s</type><code>%s</code><length>%s</length>\n<data encoding="base64">\n%s</data></item>\n' \
		"$1" "$2" "$3" "$4"
}

text_item() { # <code hex> <text>
	[ -n "$2" ] || return 0
	item 636f7265 "$1" "${#2}" "$(printf '%s' "$2" | base64 | tr -d '\n')"
}

# librespot joins multi-valued fields with newlines.
first() { printf '%s' "${1:-}" | head -n 1; }

payload=$(
	text_item 6d696e6d "$(first "${NAME:-}")"     # minm - title
	text_item 61736172 "$(first "${ARTISTS:-}")"  # asar - artist
	text_item 6173616c "$(first "${ALBUM:-}")"    # asal - album

	cover=$(first "${COVERS:-}")
	if [ -n "$cover" ] && curl -sf --max-time 5 -o /tmp/librespot-cover "$cover"; then
		item 73736e63 50494354 \
			"$(wc -c < /tmp/librespot-cover | tr -d ' ')" \
			"$(base64 < /tmp/librespot-cover | tr -d '\n')"
	fi
)

# Opening the fifo blocks until OwnTone reads it, which only happens while this
# pipe is playing. Never hang around waiting for a reader that isn't coming.
printf '%s\n' "$payload" | timeout 5 tee "$PIPE" > /dev/null
